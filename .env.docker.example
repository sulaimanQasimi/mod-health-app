APP_NAME=mod_health_app
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mod_health_app
DB_USERNAME=mod_health
DB_PASSWORD=change_me_db_password

MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_PORT=3306
HTTP_PORT=80

BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Docker / deploy
RUN_MIGRATIONS=true
RUN_COMPOSER_INSTALL=false
RUN_NPM_BUILD=false
DB_WAIT_RETRIES=60

# Build-time private Git (SSH)
# GIT_REPO=git@github.com:your-org/mod-health-app.git
# GIT_BRANCH=main
# GIT_REF=
